{
  "manifest_version": 3,
  "name": "Yaqiz – Scam Alerts for Search & Maps",
  "short_name": "Yaqiz",
  "version": "3.4",
  "description": "كشف الروابط والمواقع الاحتيالية في بحث Google وخرائط Google داخل الإمارات — يعمل محليًا بالكامل.",
  "key": "",
  "permissions": [
    "storage",
    "tabs",
    "webNavigation",
    "downloads",
    "identity",
    "alarms"
  ],
  "host_permissions": [
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "*://www.google.com/search*",
        "*://www.google.ae/search*",
        "file:///*search-mock.html",
        "http://127.0.0.1/*search-mock.html",
        "http://localhost/*search-mock.html",
        "http://127.0.0.1/*test.html",
        "http://localhost/*test.html"
      ],
      "js": [
        "i18n.js",
        "content-search.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "*://www.google.com/maps*",
        "*://www.google.ae/maps*",
        "file:///*maps-mock.html",
        "http://127.0.0.1/*maps-mock.html",
        "http://localhost/*maps-mock.html"
      ],
      "js": [
        "i18n.js",
        "phone-claims.js",
        "content-maps.js"
      ],
      "run_at": "document_idle",
      "css": [
        "content-maps.css"
      ]
    },
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "content-page.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "exclude_matches": [
        "https://www.google.com/*",
        "https://www.google.ae/*",
        "https://accounts.google.com/*",
        "https://mail.google.com/*",
        "https://drive.google.com/*",
        "https://docs.google.com/document/*",
        "https://docs.google.com/spreadsheets/*",
        "https://docs.google.com/presentation/*",
        "https://calendar.google.com/*",
        "https://meet.google.com/*",
        "https://www.youtube.com/*"
      ],
      "js": [
        "page-hooks.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Yaqiz",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "oauth2": {
    "client_id": "826368585158-squ5jv1tr5c397aedjogtou6m7d6o8gq.apps.googleusercontent.com",
    "scopes": [
      "openid",
      "email",
      "profile"
    ]
  }
}
